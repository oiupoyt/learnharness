# LearnHarness — Environment Configuration Example
# Copy to .env.local for local overrides. Secrets should never be committed.

# ── Primary LLM Provider ─────────────────────────────────────────────────────
# All standard models run through OpenRouter by default unless specific BYOK keys are used.
OPENROUTER_API_KEY=

# ── Direct Model API Keys (BYOK) ─────────────────────────────────────────────
# Required for direct provider access or when OAuth is unavailable for 3rd-party apps.
ANTHROPIC_API_KEY=     # Claude models (console.anthropic.com)
GEMINI_API_KEY=        # Google Gemini models (ai.google.dev)
OPENAI_API_KEY=        # OpenAI developer API (platform.openai.com)
XAI_API_KEY=           # Grok models (console.x.ai)
DEEPSEEK_API_KEY=      # DeepSeek models (platform.deepseek.com)

# ── OAuth Provider Configuration ─────────────────────────────────────────────
# GitHub OAuth / Copilot (RFC 8628 Device Flow)
# Defaults to a public client ID, or supply your custom GitHub OAuth App client ID:
# GITHUB_OAUTH_CLIENT_ID=
# Required Scopes: read:user
# Verification URL: https://github.com/login/device

# ChatGPT (OpenAI PKCE Loopback)
# Uses dynamic loopback on http://127.0.0.1:<port>/auth/callback
# Endpoint: https://auth.openai.com/api/accounts/authorize
# Scopes: openid profile email offline_access resource.invoke chatgpt.tokens.use.direct

# ── Research & Speech Tools ──────────────────────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
TAVILY_API_KEY=
BRAVE_API_KEY=
DEEPGRAM_API_KEY=

# ── Development & Diagnostics ────────────────────────────────────────────────
# PORT=3000
# DEBUG=learnharness:*
# ELECTRON_ENABLE_LOGGING=1
